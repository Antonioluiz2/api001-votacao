      "item": [
        {
          "name": "Cadastrar nova pauta",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Aprovação do orçamento anual 2027\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}{{contextPath}}/api/v1/pautas",
              "host": ["{{baseUrl}}{{contextPath}}"],
              "path": ["api", "v1", "pautas"]
            },
            "description": "Cadastra uma nova pauta.\n\nRequest body: CriarPautaRequest\n- descricao (String, obrigatório, @NotBlank)\n\nRespostas documentadas: 201 (criada), 400 (payload inválido)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('descricao');",
                  "    pm.expect(jsonData).to.have.property('dataCriacao');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('pautaId', jsonData.id);",
                  "}"
                ]
              }
            }
          ]
        },
